<Window x:Class="CustomControls.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CustomControls"
        
        xmlns:custom="clr-namespace:AnalogClockControl.CustomControls"
        
        mc:Ignorable="d"
        Title="Analog Clocks" Height="450" Width="800">
    <StackPanel HorizontalAlignment="Center" custom:AnalogClock.TimeChanged="AnalogClock_TimeChanged">
        <custom:AnalogClock ShowSeconds="True"/>
        <TextBlock x:Name="tbTime" Text="00:00:00" Margin="10" FontSize="50"/>
    </StackPanel>
</Window>
